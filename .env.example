# Copy to .env and insert secrets locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
LLM_PROVIDER=openai

# Development tracing stays off. Add LANGSMITH_API_KEY only when intentionally enabling tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=buzzbot-eval-dev

# Application-level tracked API ceiling in USD (code also clamps this to 3.00).
USAGE_LIMIT=3.0

# Required. This value is for the local Docker database; replace it for managed PostgreSQL.
DATABASE_URL=postgresql+asyncpg://buzzbot:buzzbot_dev@localhost:5432/buzzbot
LANGGRAPH_CHECKPOINT_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACTIVE_TERM_CODE=202608
BACKGROUND_SYNC_ENABLED=false
SCHEDULE_SYNC_INTERVAL_SECONDS=86400
DOCUMENT_SYNC_INTERVAL_SECONDS=604800
