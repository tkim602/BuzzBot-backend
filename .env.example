# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials

# ──── Database ────
DATABASE_URL=postgresql+asyncpg://buzzbot:buzzbot_dev@localhost:5432/buzzbot
DATABASE_URL_SYNC=postgresql://buzzbot:buzzbot_dev@localhost:5432/buzzbot

# ──── LLM Provider ────
LLM_PROVIDER=openai          # openai | anthropic | ollama

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (optional, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ──── RAG Settings ────
RAG_TOP_K=8
RAG_MAX_CONTEXT_TOKENS=3000
RAG_SIMILARITY_THRESHOLD=0.3

# ──── Live Fetch ────
ENABLE_LIVE_FETCH=true
LIVE_FETCH_TIMEOUT=10
LIVE_FETCH_MAX_URLS=3

# ──── Ingestion ────
INGEST_MAX_URLS_PER_SOURCE=200
INGEST_CONCURRENCY=5
INGEST_RATE_LIMIT_PER_DOMAIN=2.0
ENABLE_COMMONCRAWL=false
COMMONCRAWL_COLLECTION=

# ──── Frontend ────
NEXT_PUBLIC_API_BASE=http://localhost:8000
