# Database
DATABASE_URL=postgresql+asyncpg://buzzbot:buzzbot_dev@localhost:5432/buzzbot
DATABASE_URL_SYNC=postgresql://buzzbot:buzzbot_dev@localhost:5432/buzzbot

# LLM Provider (openai, anthropic, or ollama)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Anthropic (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# RAG
RAG_TOP_K=8
RAG_MAX_CONTEXT_TOKENS=3000
RAG_SIMILARITY_THRESHOLD=0.3
RAG_REGENERATE_ON_UNGROUNDED=false
RAG_SKIP_FTS_FOR_EXACT_SCHEDULE=true
RAG_SKIP_FTS_WHEN_VECTOR_SUFFICIENT=true
RAG_FTS_TOP_K=5
RAG_ENABLE_EMBEDDING_CACHE=true
RAG_EMBEDDING_CACHE_TTL_SECONDS=3600
RAG_EMBEDDING_CACHE_MAX_SIZE=3000
RAG_RESPONSE_CACHE_TTL_SECONDS=180
RAG_RESPONSE_CACHE_MAX_SIZE=1000

# Live fetch
ENABLE_LIVE_FETCH=true
LIVE_FETCH_TIMEOUT=10
LIVE_FETCH_MAX_URLS=3
LIVE_FETCH_MAX_CHUNKS=8

# Ingestion
INGEST_MAX_URLS_PER_SOURCE=200
INGEST_CONCURRENCY=5

# Usage tracking
USAGE_LIMIT=20.0

# Additional safeguards (independent from USAGE_LIMIT)
CHAT_RATE_LIMIT_PER_MINUTE=24
CHAT_RATE_LIMIT_PER_HOUR=240
CHAT_RATE_LIMIT_PER_DAY=400
CHAT_MIN_INTERVAL_SECONDS=0.8
CHAT_DUPLICATE_COOLDOWN_SECONDS=20
CHAT_MAX_CONCURRENCY=12
CHAT_QUEUE_TIMEOUT_SECONDS=5
