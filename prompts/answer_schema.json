{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuzzBot Chat Response",
  "type": "object",
  "required": ["answer", "citations", "confidence"],
  "properties": {
    "answer": {
      "type": "string",
      "description": "The main answer text"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "quote"],
        "properties": {
          "url": {"type": "string"},
          "title": {"type": ["string", "null"]},
          "fetched_at": {"type": ["string", "null"]},
          "quote": {"type": "string"}
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
