{
  "type": "object",
  "properties": {
    "answer": { "type": "string" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "needs_followup": { "type": "boolean" },
    "followup_question": { "type": ["string", "null"] },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "section": { "type": ["string", "null"] },
          "fetched_at": { "type": ["string", "null"] },
          "excerpt": { "type": ["string", "null"] }
        },
        "required": ["url", "title", "section", "fetched_at", "excerpt"]
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "debug": {
      "type": "object",
      "properties": {
        "intent": { "type": ["string", "null"] },
        "live_fetch_used": { "type": ["boolean", "null"] },
        "retrieval_top_k": { "type": ["integer", "null"] }
      },
      "required": ["intent", "live_fetch_used", "retrieval_top_k"]
    }
  },
  "required": [
    "answer",
    "confidence",
    "needs_followup",
    "followup_question",
    "citations",
    "warnings",
    "debug"
  ]
}
