{
  "type": "object",
  "properties": {
    "intent": { "type": "string" },
    "live_fetch": { "type": "boolean" },
    "freshness_reason": { "type": "string" },
    "extracted_entities": {
      "type": "object",
      "properties": {
        "course_codes": { "type": "array", "items": { "type": "string" } },
        "term": { "type": ["string", "null"] },
        "professor_names": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["course_codes", "term", "professor_names", "keywords"]
    },
    "retrieval_filters": {
      "type": "object",
      "properties": {
        "doc_type": { "type": "array", "items": { "type": "string" } },
        "course_code": { "type": ["string", "null"] },
        "term": { "type": ["string", "null"] }
      },
      "required": ["doc_type", "course_code", "term"]
    },
    "preferred_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "rationale": { "type": "string" }
        },
        "required": ["domain", "priority", "rationale"]
      }
    },
    "clarifying_question": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": [
    "intent",
    "live_fetch",
    "freshness_reason",
    "extracted_entities",
    "retrieval_filters",
    "preferred_sources",
    "clarifying_question",
    "confidence"
  ]
}
